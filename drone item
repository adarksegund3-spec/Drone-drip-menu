local function BuildDrone()
    local model = Instance.new("Model")
    model.Name = TAG .. "_Model"
    local core = Instance.new("Part")
    core.Name, core.Size, core.Transparency = "Core", V(1, 1, 1), 1
    core.Anchored, core.CanCollide, core.CanQuery, core.CanTouch, core.CastShadow = true, false, false, false, false
    core.Parent = model
    model.PrimaryPart = core
    CTX = { model = model, core = core, parts = {}, leds = {}, props = {}, guis = {} }
    local ok, err = pcall(function()
        CreateDroneBody()
        CreateDroneArms()
        CreateDroneMotors()
        CreateDronePropellers()
        CreateDroneCamera()
        CreateDroneBattery()
        CreateDroneLights()
        CreateDroneDetails()
        CreateDroneSignature()
    end)
    local ctx = CTX
    CTX = nil
    if not ok then
        model:Destroy()
        error("construcao do modelo falhou: " .. tostring(err))
    end
    return { model = model, core = core, parts = ctx.parts, leds = ctx.leds, props = ctx.props, guis = ctx.guis, hidden = false, blinkOn = true }
end

local function SetLeds(d, on)
    for _, l in ipairs(d.leds) do
        if l.part.Parent then
            l.part.Color = on and l.on or l.off
            l.part.Material = on and MAT.Neon or MAT.SmoothPlastic
        end
    end
end

local function Retire(d, spin)
    if not d then return end
    task.spawn(function()
        SetLeds(d, false)
        local t0, s, ang = os.clock(), spin or 30, S.ang
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not d.model.Parent then conn:Disconnect() return end
            s = s * math.exp(-4 * dt)
            ang = ang + s * dt
            for _, p in ipairs(d.props) do
                p.weld.C0 = p.base * ANG(0, ang * p.dir, 0)
                p.disc.Transparency = 1 - 0.14 * math.clamp(s / 45, 0, 1)
            end
            if os.clock() - t0 > 1.2 then
                conn:Disconnect()
                d.model:Destroy()
            end
        end)
    end)
end

