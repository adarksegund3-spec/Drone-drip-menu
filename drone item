-- tenta colocar o item na hotbar; se estiver cheia, manda a ultima ferramenta da hotbar para a mochila
local function placeTool(tool, bp, char)
    local others, equipped = {}, 0
    for _, c in ipairs(bp:GetChildren()) do
        if c:IsA("Tool") and c ~= tool then table.insert(others, c) end
    end
    if char then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") then equipped += 1 end
        end
    end
    if #others + equipped < HOTBAR_SLOTS then
        return pcall(function() tool.Parent = bp end)
    end
    local victim = others[math.min(math.max(HOTBAR_SLOTS - equipped, 1), #others)]
    if not victim then return pcall(function() tool.Parent = bp end) end
    local ok = pcall(function()
        victim.Parent = nil
        tool.Parent = bp
    end)
    pcall(function() victim.Parent = bp end) -- sempre devolve a ferramenta (vai para a mochila)
    return ok and tool.Parent == bp, victim.Name
end

local function MakeTool()
    for _, c in ipairs(G.toolCons) do pcall(c.Disconnect, c) end
    table.clear(G.toolCons)
    local bp = LP:FindFirstChildOfClass("Backpack") or LP:WaitForChild("Backpack", 5)
    if not bp then warnf("Backpack nao encontrado") return nil end
    for _, holder in ipairs({ bp, LP.Character }) do -- sem copias duplicadas
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute(TAG) then t:Destroy() end
            end
        end
    end
    local okT, tool = pcall(function()
        local t = Instance.new("Tool")
        t.Name, t.RequiresHandle, t.CanBeDropped, t.ToolTip = "Drone", false, false, "Drone | by: Angel"
        t:SetAttribute(TAG, true)
        return t
    end)
    if not okT or not tool then warnf("falha ao criar o item:", tool) return nil end

    local inHotbar, moved = placeTool(tool, bp, LP.Character)
    if not tool.Parent then pcall(function() tool.Parent = bp end) end
    if not tool.Parent then
        warnf("item nao pode ser adicionado ao inventario")
        pcall(tool.Destroy, tool)
        return nil
    end
    table.insert(G.toolCons, tool.Equipped:Connect(function() Launch() end))
    table.insert(G.toolCons, tool.Unequipped:Connect(function() Retract("item") end))
    S.tool = tool
    log("item 'Drone' criado", inHotbar and "(hotbar)" or "(mochila)")
    if Notify then
        if not inHotbar then
            Notify("Inventário cheio", "O item está na sua mochila!")
        elseif moved then
            Notify("Hotbar cheia", moved .. " foi para a mochila", "info")
        end
    end
    return tool
end

