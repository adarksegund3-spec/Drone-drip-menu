local CTX -- contexto de construcao atual

local function weldTo(root, part, rel)
    local w = Instance.new("Weld")
    w.Part0, w.Part1, w.C0 = root, part, rel
    w.Parent = part
    return w
end

local function basePart(name, size, color, mat)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Color = name, size, color
    p.Material = mat or MAT.SmoothPlastic
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = false, false, false, false
    p.Massless, p.CastShadow = true, false
    return p
end

local function add(root, name, size, offset, color, mat)
    local p = basePart(name, size, color, mat)
    p.CFrame = root.CFrame * offset
    p.Parent = CTX.model
    weldTo(root, p, offset)
    table.insert(CTX.parts, p)
    return p
end

local AX = {
    X = CFrame.identity,
    Y = CFrame.Angles(0, 0, math.pi / 2),
    Z = CFrame.Angles(0, math.pi / 2, 0),
}
local function cyl(root, name, h, d, offset, color, mat, axis)
    local p = add(root, name, V(h, d, d), offset * AX[axis or "Y"], color, mat)
    p.Shape = Enum.PartType.Cylinder
    return p
end

local function ball(root, name, d, offset, color, mat)
    local p = add(root, name, V(d, d, d), offset, color, mat)
    p.Shape = Enum.PartType.Ball
    return p
end

local function screw(root, pos, d, yaw)
    cyl(root, "Screw", 0.04, d, CF(pos + V(0, 0.02, 0)), C.silver, MAT.Metal, "Y")
    add(root, "ScrewSlot", V(d * 0.8, 0.012, d * 0.16), CF(pos + V(0, 0.043, 0)) * ANG(0, yaw or 0, 0), C.black)
end

local function led(root, name, size, offset, color, blink)
    local p = add(root, name, size, offset, color, MAT.Neon)
    table.insert(CTX.leds, {
        part = p, on = color, blink = blink,
        off = color:Lerp(Color3.fromRGB(10, 10, 12), 0.85),
    })
    return p
end

local function CreateDroneBody()
    local core = CTX.core
    -- casco inferior com bordas arredondadas
    add(core, "HullLower", V(1.75, 0.45, 3.0), CF(0, -0.15, 0), C.black)
    for _, s in ipairs({ -1, 1 }) do
        cyl(core, "HullEdge", 3.0, 0.45, CF(s * 0.875, -0.15, 0), C.black, nil, "Z")
        cyl(core, "ShellEdge", 2.3, 0.36, CF(s * 0.77, 0.255, 0.15), C.graphite, nil, "Z")
    end
    -- casco superior + chanfros frontal/traseiro
    add(core, "ShellUpper", V(1.54, 0.36, 2.3), CF(0, 0.255, 0.15), C.graphite)
    add(core, "NoseChamfer", V(1.9, 0.28, 0.9), CF(0, 0.23, -1.2) * ANG(rad(-22), 0, 0), C.graphite)
    add(core, "TailChamfer", V(1.9, 0.28, 0.7), CF(0, 0.25, 1.2) * ANG(rad(22), 0, 0), C.graphite)
end

local function CreateDroneArms()
    local core = CTX.core
    for _, a in ipairs(ARMS) do
        local B = ANG(0, rad(a.yaw), 0)
        local function A(x, y, z) return B * CF(x, y, z) end
        add(core, "ArmBeam", V(0.46, 0.26, 2.7), A(0, 0, -2.35), C.plastic, MAT.Plastic)
        add(core, "ArmCover", V(0.34, 0.1, 1.9), A(0, 0.18, -2.35), C.graphite)
        add(core, "ArmRib", V(0.2, 0.12, 2.0), A(0, -0.19, -2.35), C.metal, MAT.Metal)
        add(core, "ArmStripe", V(0.05, 0.012, 0.9), A(0, 0.236, -2.4), C.blueDim)
        add(core, "ArmGusset", V(0.9, 0.36, 0.8), A(0, 0, -1.55), C.dark, MAT.Metal)
        screw(core, A(0.2, 0.18, -1.4).Position, 0.12, rad(a.yaw))
        screw(core, A(-0.2, 0.18, -1.7).Position, 0.12, rad(a.yaw))
    end
end

local function CreateDroneMotors()
    local core = CTX.core
    for _, a in ipairs(ARMS) do
        local B = ANG(0, rad(a.yaw), 0)
        local function A(x, y, z) return B * CF(x, y, z) end
        cyl(core, "MotorMountLow", 0.12, 0.75, A(0, -0.19, -R), C.dark, MAT.Metal)
        cyl(core, "MotorPlate", 0.1, 1.05, A(0, 0.2, -R), C.metal, MAT.Metal)
        cyl(core, "MotorHousing", 0.42, 0.82, A(0, 0.46, -R), C.dark, MAT.Metal)
        cyl(core, "MotorRingSilver", 0.05, 0.88, A(0, 0.33, -R), C.silver, MAT.Metal)
        cyl(core, "MotorRingBlue", 0.04, 0.86, A(0, 0.6, -R), C.blueDim)
        cyl(core, "MotorCap", 0.1, 0.55, A(0, 0.72, -R), C.graphite)
        cyl(core, "MotorShaft", 0.16, 0.16, A(0, 0.83, -R), C.silver, MAT.Metal)
        for k = 0, 2 do
            local t = k * 2 * math.pi / 3
            screw(core, A(math.cos(t) * 0.42, 0.25, -R + math.sin(t) * 0.42).Position, 0.1, 0)
        end
    end
end

local function CreateDronePropellers()
    local core = CTX.core
    for _, a in ipairs(ARMS) do
        local base = ANG(0, rad(a.yaw), 0) * CF(0, 0.95, -R)
        local root = basePart("PropRoot", V(0.2, 0.2, 0.2), C.black)
        root.Transparency = 1
        root.CFrame = core.CFrame * base
        root.Parent = CTX.model
        local w = weldTo(core, root, base)
        cyl(root, "PropHub", 0.14, 0.4, CF(0, 0, 0), C.dark, MAT.Metal)
        cyl(root, "PropNut", 0.1, 0.2, CF(0, 0.09, 0), C.silver, MAT.Metal)
        for _, s in ipairs({ 1, -1 }) do
            add(root, "Blade", V(1.45, 0.035, 0.3), CF(s * 0.88, 0.01, 0) * ANG(s * rad(9), 0, 0), C.plastic, MAT.Plastic)
            add(root, "BladeTip", V(0.4, 0.03, 0.2), CF(s * 1.66, 0.04, 0) * ANG(0, 0, s * rad(7)), C.blueDim, MAT.Plastic)
        end
        local disc = cyl(root, "PropDisc", 0.01, 3.7, CF(0, 0.03, 0), C.silver)
        disc.Transparency = 1
        table.insert(CTX.props, { weld = w, base = base, dir = a.dir, disc = disc })
    end
end

