local function Step(dt)
    local d, sv = S.d, S.sv
    if not (d and sv and d.core.Parent and sv.hum.Parent and sv.hrp.Parent) then
        error("drone ou personagem perdido")
    end
    local cam, core = sv.cam, d.core
    if cam.CameraSubject ~= core then cam.CameraSubject = core end
    if not sv.hrp.Anchored then sv.hrp.Anchored = true end

    local now = os.clock()
    local alive = now - S.t0
    local mv = sv.hum.MoveDirection
    local vert = ((S.input.keyUp or S.input.btnUp) and 1 or 0) - ((S.input.keyDown or S.input.btnDown) and 1 or 0)
    local target = V(mv.X * CFG.speed, vert * CFG.climb, mv.Z * CFG.speed)
    if alive < CFG.riseTime then target = target + V(0, CFG.riseSpeed, 0) end
    local rate = target.Magnitude > 0.05 and CFG.accel or CFG.brake
    S.vel = S.vel:Lerp(target, 1 - math.exp(-rate * dt))

    -- movimento + colisao simples (desliza nas paredes)
    local pos, delta = S.pos, S.vel * dt
    local dist = delta.Magnitude
    if dist > 1e-5 then
        local hit = alive > CFG.riseTime and sweep(pos, delta) or nil
        if hit and hit.Normal.Magnitude > 0.1 then
            pos = pos + delta.Unit * math.min(math.max(hit.Distance - 0.03, 0), dist)
            local into = S.vel:Dot(hit.Normal)
            if into < 0 then S.vel = S.vel - hit.Normal * into end
        else
            pos = pos + delta
        end
    end
    S.pos = pos

    -- orientacao
    local h = V(S.vel.X, 0, S.vel.Z)
    local hs = h.Magnitude
    if hs > 3 then
        local ty = math.atan2(-h.X, -h.Z)
        local diff = (ty - S.yaw + math.pi) % (2 * math.pi) - math.pi
        S.yaw = S.yaw + diff * (1 - math.exp(-CFG.turn * dt))
    end
    local yawCF = ANG(0, S.yaw, 0)
    local lv = yawCF:VectorToObjectSpace(S.vel)
    local tp = rad(CFG.tilt) * math.clamp(lv.Z / CFG.speed, -1, 1)
    local tr = -rad(CFG.tilt) * math.clamp(lv.X / CFG.speed, -1, 1)
    local k = 1 - math.exp(-8 * dt)
    S.pitch = S.pitch + (tp - S.pitch) * k
    S.roll = S.roll + (tr - S.roll) * k
    local bob = math.sin(now * 2.2) * 0.06
    core.CFrame = CF(pos + V(0, bob, 0)) * yawCF * ANG(S.pitch, 0, S.roll)

    -- helices (independentes do corpo)
    local spinTarget = CFG.spinIdle + (CFG.spinMove - CFG.spinIdle) * math.clamp(S.vel.Magnitude / CFG.speed, 0, 1)
    S.spin = S.spin + (spinTarget - S.spin) * (1 - math.exp(-2.5 * dt))
    S.ang = (S.ang + S.spin * dt) % (2 * math.pi)
    local blur = 1 - 0.14 * math.clamp(S.spin / 45, 0, 1)
    for _, p in ipairs(d.props) do
        p.weld.C0 = p.base * ANG(0, S.ang * p.dir, 0)
        p.disc.Transparency = blur
    end

    -- LED de estado piscando
    local on = (now % 1) < 0.5
    if on ~= d.blinkOn then
        d.blinkOn = on
        for _, l in ipairs(d.leds) do
            if l.blink then l.part.Color = on and l.on or l.off end
        end
    end

    -- HUD (telemetria) + atualiza filtro de colisao (jogadores que entram/renascem)
    if ui and ui.alt then
        if ui.dot then ui.dot.BackgroundTransparency = 0.45 + 0.4 * math.sin(now * 5) end
        if now - (S.hudT or 0) > 0.1 then
            S.hudT = now
            local base = sv.hrp.Position
            ui.alt.Text = tostring(math.floor(pos.Y - base.Y + 0.5))
            ui.spd.Text = tostring(math.floor(S.vel.Magnitude + 0.5))
            ui.dst.Text = tostring(math.floor((pos - base).Magnitude + 0.5))
        end
    end
    if now - (S.filtT or 0) > 1 then
        S.filtT = now
        S.rayParams.FilterDescendantsInstances = playerFilter(d)
    end

    -- primeira pessoa: esconde o modelo para nao ficar "dentro" dele
    local near = (cam.CFrame.Position - core.Position).Magnitude < 2.2
    if near ~= d.hidden then
        d.hidden = near
        for _, p in ipairs(d.parts) do p.LocalTransparencyModifier = near and 1 or 0 end
        for _, g in ipairs(d.guis) do g.Enabled = not near end
    end
end

Retract = function(reason)
    if not S.active then return end
    S.active = false
    pcall(RunService.UnbindFromRenderStep, RunService, BIND)
    for _, c in ipairs(S.cons) do pcall(c.Disconnect, c) end
    table.clear(S.cons)
    for key in pairs(S.input) do S.input[key] = false end

    local sv, d = S.sv, S.d
    S.sv, S.d = nil, nil
    if sv then
        pcall(function() sv.hrp.Anchored = sv.anchored end)
        pcall(function()
            local h = sv.hum
            h.WalkSpeed, h.JumpPower, h.JumpHeight, h.AutoRotate = sv.walk, sv.jumpPower, sv.jumpHeight, sv.autoRotate
        end)
        pcall(function()
            local hum = (LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")) or sv.hum
            sv.cam.CameraSubject = hum
            sv.cam.CameraType = sv.camType
        end)
    end
    Retire(d, S.spin)
    UpdateUI()
    if #S.cons ~= 0 then warnf("conexoes restantes apos encerrar:", #S.cons) end
    log("drone recolhido (" .. tostring(reason or "?") .. ")")
end

local function Launch()
    if S.active then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if not (hum and hrp and cam and hum.Health > 0) then
        warnf("personagem ou camera indisponivel")
        return
    end
    local okB, d = pcall(BuildDrone)
    if not okB then warnf("falha ao criar drone:", d) return end

    S.active, S.d = true, d
    S.sv = {
        hum = hum, hrp = hrp, cam = cam,
        walk = hum.WalkSpeed, jumpPower = hum.JumpPower, jumpHeight = hum.JumpHeight,
        autoRotate = hum.AutoRotate, anchored = hrp.Anchored, camType = cam.CameraType,
    }
    local ok, err = pcall(function()
        -- personagem parado no lugar
        hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate = 0, 0, 0, false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.Anchored = true

        local lv = hrp.CFrame.LookVector
        S.yaw = math.atan2(-lv.X, -lv.Z)
        S.pos = hrp.Position + V(0, CFG.spawnHeight, 0)
        S.vel, S.pitch, S.roll, S.spin, S.t0 = Vector3.zero, 0, 0, 0, os.clock()
        d.model:PivotTo(CF(S.pos) * ANG(0, S.yaw, 0))
        d.model.Parent = Workspace
        SetLeds(d, true)

        S.rayParams = RaycastParams.new()
        S.rayParams.FilterType = Enum.RaycastFilterType.Exclude
        S.rayParams.FilterDescendantsInstances = playerFilter(d)

        if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
        cam.CameraSubject = d.core

        table.insert(S.cons, hum.Died:Connect(function() Retract("morreu") end))
        table.insert(S.cons, UIS.InputBegan:Connect(function(i)
            if UIS:GetFocusedTextBox() then return end
            local kc = i.KeyCode
            if kc == Enum.KeyCode.E or kc == Enum.KeyCode.Space then S.input.keyUp = true
            elseif kc == Enum.KeyCode.Q or kc == Enum.KeyCode.LeftControl then S.input.keyDown = true end
        end))
        table.insert(S.cons, UIS.InputEnded:Connect(function(i)
            local kc = i.KeyCode
            if kc == Enum.KeyCode.E or kc == Enum.KeyCode.Space then S.input.keyUp = false
            elseif kc == Enum.KeyCode.Q or kc == Enum.KeyCode.LeftControl then S.input.keyDown = false end
        end))

        RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value - 1, function(dt)
            local good, e = xpcall(Step, function(m) return debug.traceback(tostring(m)) end, dt)
            if not good then
                warnf("erro durante o voo:", e)
                Retract("erro")
            end
        end)
        UpdateUI()
    end)
    if not ok then
        warnf("falha ao iniciar pilotagem:", err)
        Retract("falha ao iniciar")
        return
    end
    log("drone ativo")
end

