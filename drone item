local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function guiContainers()
    local list = {}
    if gethui then local ok, h = pcall(gethui) if ok and h then table.insert(list, h) end end
    table.insert(list, game:GetService("CoreGui"))
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then table.insert(list, pg) end
    return list
end

local function makeDraggable(frame)
    local dragging, dragInput, startInput, startPos
    table.insert(G.cons, frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startInput, startPos = true, i.Position, frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))
    table.insert(G.cons, frame.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            dragInput = i
        end
    end))
    table.insert(G.cons, UIS.InputChanged:Connect(function(i)
        if dragging and i == dragInput then
            local dl = i.Position - startInput
            local vp = (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize) or V(800, 400, 0)
            local x = math.clamp(startPos.X.Offset + dl.X, 0, math.max(vp.X - frame.AbsoluteSize.X, 0))
            local y = math.clamp(startPos.Y.Offset + dl.Y, 0, math.max(vp.Y - frame.AbsoluteSize.Y, 0))
            frame.Position = UDim2.fromOffset(x, y)
        end
    end))
end

local function holdButton(btn, key, onState)
    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
    end
    local function set(v)
        S.input[key] = v
        if onState then onState(v) end
    end
    table.insert(G.cons, btn.InputBegan:Connect(function(i)
        if isPress(i) then
            set(true)
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then set(false) end
            end)
        end
    end))
    table.insert(G.cons, btn.InputEnded:Connect(function(i)
        if isPress(i) then set(false) end
    end))
end

