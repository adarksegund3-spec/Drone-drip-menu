local function sweep(pos, delta)
    local dist, dir = delta.Magnitude, delta.Unit
    local ok, res = pcall(Workspace.Spherecast, Workspace, pos, CFG.radius, dir * (dist + 0.05), S.rayParams)
    if not ok then
        res = Workspace:Raycast(pos, dir * (dist + CFG.radius), S.rayParams)
        if res then res = { Distance = math.max(res.Distance - CFG.radius, 0), Normal = res.Normal } end
    end
    return res
end

-- o drone nao colide com nenhum jogador (nem personagens)
local function playerFilter(d)
    local list = { d.model }
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(list, pl.Character) end
    end
    return list
end

-- teleporta o personagem (parado) ate o chao embaixo do drone
local function GoToDrone()
    local sv = S.sv
    if not (S.active and S.d and sv and sv.hrp.Parent) then return false end
    local target = S.pos
    local ok, res = pcall(function() return Workspace:Raycast(S.pos, V(0, -3000, 0), S.rayParams) end)
    if ok and res then
        target = res.Position + V(0, sv.hum.HipHeight + sv.hrp.Size.Y / 2 + 0.5, 0)
    end
    local rot = sv.hrp.CFrame - sv.hrp.CFrame.Position
    sv.hrp.CFrame = CF(target) * rot
    sv.hrp.AssemblyLinearVelocity = Vector3.zero
    return true
end

